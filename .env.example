# bitWitch lab configuration. Copy to .env, edit, keep .env out of git.

# Address the web UI binds to. Set to the lab-facing IP so the school network
# cannot find the form. 0.0.0.0 means "anything that can route here".
BITWITCH_BIND_IP=0.0.0.0
BITWITCH_PORT=8099

# Everything a student needs. Change per term.
BITWITCH_PASSWORD=changeme

# Admins only: unlocks the /admin page where the target scope is set.
# Leave EMPTY to disable admin sign-in entirely.
BITWITCH_ADMIN_PASSWORD=

# Sessions are signed with this. Set it to keep logins across restarts;
# blank means a random key at boot, so a restart signs everyone out.
BITWITCH_SECRET=

# Which docker network to join. Use the same network Trapdoor's ports sit on.
BITWITCH_NETWORK=labnet
BITWITCH_NETWORK_EXTERNAL=false
